# --- Application ---
APP_NAME=ai-revenue-recovery-agent
ENV=local
LOG_LEVEL=INFO

# --- Database ---
# Used by the running app and by Alembic migrations.
DATABASE_URL=postgresql+psycopg2://recovery_user:recovery_pass@localhost:5432/recovery_db

# Used only by the test suite (pytest). Point this at a throwaway database.
# If not set, tests will refuse to run against a database whose name
# doesn't end in "_test", as a safety guard against wiping dev data.
TEST_DATABASE_URL=postgresql+psycopg2://recovery_user:recovery_pass@localhost:5432/recovery_db_test

# --- CORS (frontend origin, added in a later phase) ---
CORS_ORIGINS=http://localhost:5173

# --- Webhooks (Phase 2) ---
# From the Razorpay Dashboard: Settings > Webhooks > (your webhook) > Secret.
# Required only for the real /webhooks/razorpay endpoint. The local
# /simulate/failed-payment endpoint needs no credential at all.
RAZORPAY_WEBHOOK_SECRET=

# Single-tenant MVP: every ingested payment resolves to this merchant_id.
# Auto-provisioned with default policy values on first use.
DEFAULT_MERCHANT_ID=default_merchant

# --- AI decision service (Phase 3) ---
# "mock": deterministic, rule-based, zero credentials — the default, so
#   the full pipeline is demoable with no setup.
# "anthropic": real Claude calls; requires ANTHROPIC_API_KEY below.
AI_PROVIDER=mock

# From console.anthropic.com. Only required when AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Any current Claude model that supports Structured Outputs
# (platform.claude.com/docs/en/build-with-claude/structured-outputs).
AI_MODEL_NAME=claude-sonnet-5

AI_REQUEST_TIMEOUT_SECONDS=20.0

# Below this, the LLM's recommendation is discarded in favor of a
# deterministic ESCALATE_TO_MERCHANT fallback (see ai_decision_service.py).
AI_MIN_CONFIDENCE_THRESHOLD=0.4

# --- Recovery action execution (Phase 5) ---
# "mock": simulates every outbound gateway call deterministically, zero
#   credentials — the default, so the full recovery flow is demoable.
# "razorpay": real calls to the Razorpay Payment Links API. Requires
#   RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET below.
RECOVERY_GATEWAY_PROVIDER=mock

# From the Razorpay Dashboard: Settings > API Keys. Only required when
# RECOVERY_GATEWAY_PROVIDER=razorpay. Never the same as
# RAZORPAY_WEBHOOK_SECRET above — that one only verifies inbound
# webhook signatures and can't be used to call the API.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_TIMEOUT_SECONDS=15.0

# Only "mock" is implemented — logs the notification and returns
# success. Point this at a real channel once one is actually wired up.
NOTIFICATION_PROVIDER=mock

# Single-tenant MVP: where ESCALATE_TO_MERCHANT notifications go.
MERCHANT_ESCALATION_EMAIL=ops@merchant.example
